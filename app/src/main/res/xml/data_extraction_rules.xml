<?xml version="1.0" encoding="utf-8"?>
<!-- নামাজের লগ ব্যক্তিগত — Google ক্লাউড ব্যাকআপ বা ডিভাইস ট্রান্সফারে যাবে না -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
